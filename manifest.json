{
  "manifest_version": 3,
  "name": "Subtitle Finder",
  "version": "0.1.0",
  "description": "Find matching subtitles for videos playing in your browser.",
  "action": {
    "default_title": "Subtitle Finder"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}